<mujoco model="original_keyboard_biped">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global offwidth="960" offheight="720"/>
  </visual>
  <default>
    <joint damping="0.8" armature="0.01"/>
    <geom contype="0" conaffinity="0"/>
  </default>
  <asset>
    <material name="body" rgba="0.18 0.34 0.60 1"/>
    <material name="limb" rgba="0.88 0.89 0.85 1"/>
    <material name="joint" rgba="0.95 0.48 0.10 1"/>
    <material name="floor" rgba="0.78 0.81 0.84 1"/>
  </asset>
  <worldbody>
    <light pos="1 -1 3" dir="-0.4 0.4 -1" diffuse="0.9 0.9 0.9"/>
    <geom type="plane" size="8 8 0.05" material="floor"/>

    <body name="robot_base" mocap="true" pos="0 0 0.98">
      <geom name="pelvis" type="box" pos="0 0 0.03" size="0.16 0.19 0.09"
            material="joint" mass="5"/>
      <geom name="torso" type="box" pos="0 0 0.37" size="0.16 0.20 0.27"
            material="body" mass="12"/>
      <geom name="head" type="sphere" pos="0 0 0.76" size="0.095"
            material="limb" mass="2"/>

      <body name="left_arm" pos="0 -0.21 0.54">
        <joint name="l_shoulder" axis="0 1 0" range="-1.0 1.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.28" size="0.04"
              material="limb" mass="1.3"/>
        <body name="left_forearm" pos="0 0 -0.28">
          <joint name="l_elbow" axis="0 1 0" range="-1.5 0.1"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.24" size="0.035"
                material="limb" mass="1.0"/>
        </body>
      </body>
      <body name="right_arm" pos="0 0.21 0.54">
        <joint name="r_shoulder" axis="0 1 0" range="-1.0 1.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.28" size="0.04"
              material="limb" mass="1.3"/>
        <body name="right_forearm" pos="0 0 -0.28">
          <joint name="r_elbow" axis="0 1 0" range="-1.5 0.1"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.24" size="0.035"
                material="limb" mass="1.0"/>
        </body>
      </body>

      <body name="left_thigh" pos="0 -0.10 -0.05">
        <joint name="l_hip" axis="0 1 0" range="-0.85 0.85"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.38" size="0.052"
              material="limb" mass="2.8"/>
        <body name="left_shin" pos="0 0 -0.38">
          <joint name="l_knee" axis="0 1 0" range="-1.1 0.15"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.38" size="0.045"
                material="limb" mass="2.0"/>
          <body name="left_foot" pos="0 0 -0.38">
            <joint name="l_ankle" axis="0 1 0" range="-0.7 0.7"/>
            <geom type="box" pos="0.07 0 -0.03" size="0.14 0.07 0.03"
                  material="joint" mass="0.8"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 0.10 -0.05">
        <joint name="r_hip" axis="0 1 0" range="-0.85 0.85"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.38" size="0.052"
              material="limb" mass="2.8"/>
        <body name="right_shin" pos="0 0 -0.38">
          <joint name="r_knee" axis="0 1 0" range="-1.1 0.15"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.38" size="0.045"
                material="limb" mass="2.0"/>
          <body name="right_foot" pos="0 0 -0.38">
            <joint name="r_ankle" axis="0 1 0" range="-0.7 0.7"/>
            <geom type="box" pos="0.07 0 -0.03" size="0.14 0.07 0.03"
                  material="joint" mass="0.8"/>
          </body>
        </body>
      </body>
    </body>

    <camera name="view" pos="2.3 -2.8 1.8" xyaxes="0.77 0.63 0 -0.30 0.37 0.88"
            fovy="45"/>
  </worldbody>

  <actuator>
    <position name="l_hip_servo" joint="l_hip" kp="120" kv="18" ctrlrange="-0.85 0.85"/>
    <position name="l_knee_servo" joint="l_knee" kp="120" kv="18" ctrlrange="-1.1 0.15"/>
    <position name="l_ankle_servo" joint="l_ankle" kp="90" kv="14" ctrlrange="-0.7 0.7"/>
    <position name="r_hip_servo" joint="r_hip" kp="120" kv="18" ctrlrange="-0.85 0.85"/>
    <position name="r_knee_servo" joint="r_knee" kp="120" kv="18" ctrlrange="-1.1 0.15"/>
    <position name="r_ankle_servo" joint="r_ankle" kp="90" kv="14" ctrlrange="-0.7 0.7"/>
    <position name="l_shoulder_servo" joint="l_shoulder" kp="70" kv="10" ctrlrange="-1 1"/>
    <position name="l_elbow_servo" joint="l_elbow" kp="60" kv="9" ctrlrange="-1.5 0.1"/>
    <position name="r_shoulder_servo" joint="r_shoulder" kp="70" kv="10" ctrlrange="-1 1"/>
    <position name="r_elbow_servo" joint="r_elbow" kp="60" kv="9" ctrlrange="-1.5 0.1"/>
  </actuator>
</mujoco>
