<mujoco model="keyboard_arm_assignment">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="960" offheight="720"/>
  </visual>

  <default>
    <geom contype="0" conaffinity="0"/>
    <default class="arm">
      <geom material="white" contype="1" conaffinity="1"/>
    </default>
    <default class="orange">
      <geom material="orange" contype="1" conaffinity="1"/>
    </default>
    <default class="white">
      <geom material="white" contype="1" conaffinity="1"/>
    </default>
    <default class="black">
      <geom material="black" contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <material name="white" rgba="0.92 0.92 0.88 1"/>
    <material name="orange" rgba="0.95 0.48 0.12 1"/>
    <material name="black" rgba="0.08 0.08 0.09 1"/>
    <material name="floor" rgba="0.72 0.76 0.80 1"/>
    <material name="target" rgba="0.15 0.72 0.42 0.82"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.2 -0.4 2.0" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.05" material="floor" contype="1" conaffinity="1"/>

    <body name="base" pos="0 0 0.045">
      <geom name="base_geom" type="cylinder" size="0.14 0.045" class="black"/>

      <body name="link1" pos="0 0 0.06">
        <joint name="joint1" axis="0 0 1" range="-2.90 2.90" damping="0.7" armature="0.02"/>
        <geom name="link1_geom" type="cylinder" size="0.105 0.08" class="orange"/>

        <body name="link2" pos="0 0 0.10">
          <joint name="joint2" axis="0 1 0" range="-1.76 1.76" damping="0.7" armature="0.02"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.34" size="0.055" class="white"/>
          <geom name="joint2_cover" type="sphere" pos="0 0 0" size="0.075" class="orange"/>

          <body name="link3" pos="0 0 0.34">
            <joint name="joint3" axis="0 1 0" range="-2.90 2.90" damping="0.7" armature="0.02"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 0.30" size="0.05" class="white"/>
            <geom name="joint3_cover" type="sphere" pos="0 0 0" size="0.07" class="orange"/>

            <body name="link4" pos="0 0 0.30">
              <joint name="joint4" axis="0 0 1" range="-3.07 3.07" damping="0.55" armature="0.015"/>
              <geom name="link4_geom" type="capsule" fromto="0 0 0 0 0 0.18" size="0.046" class="white"/>
              <geom name="joint4_cover" type="sphere" pos="0 0 0" size="0.064" class="orange"/>

              <body name="link5" pos="0 0 0.18">
                <joint name="joint5" axis="0 1 0" range="-2.90 2.90" damping="0.55" armature="0.015"/>
                <geom name="link5_geom" type="capsule" fromto="0 0 0 0 0 0.12" size="0.042" class="white"/>
                <geom name="joint5_cover" type="sphere" pos="0 0 0" size="0.058" class="orange"/>

                <body name="link6" pos="0 0 0.12">
                  <joint name="joint6" axis="1 0 0" range="-0.02 3.75" damping="0.45" armature="0.012"/>
                  <geom name="link6_geom" type="capsule" fromto="0 0 0 0 0 0.09" size="0.038" class="white"/>

                  <body name="link7" pos="0 0 0.09">
                    <joint name="joint7" axis="0 0 1" range="-2.90 2.90" damping="0.45" armature="0.012"/>
                    <geom name="wrist" type="cylinder" size="0.055 0.045" class="black"/>
                    <geom name="palm" type="box" pos="0 0 0.075" size="0.09 0.045 0.03" class="orange"/>
                    <camera name="front_camera" pos="0 -0.75 1.0" xyaxes="1 0 0 0 0 1" fovy="50"/>

                    <body name="finger_left" pos="0 0.045 0.115">
                      <joint name="finger_left" type="slide" axis="0 1 0" range="0 0.035" damping="8"/>
                      <geom type="box" pos="0 0.018 0.045" size="0.018 0.014 0.05" class="black"/>
                    </body>
                    <body name="finger_right" pos="0 -0.045 0.115">
                      <joint name="finger_right" type="slide" axis="0 -1 0" range="0 0.035" damping="8"/>
                      <geom type="box" pos="0 -0.018 0.045" size="0.018 0.014 0.05" class="black"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="target_marker" pos="0.48 0.12 0.24">
      <geom type="sphere" size="0.045" material="target" contype="0" conaffinity="0"/>
    </body>

    <camera name="overview" pos="1.35 -1.50 1.25" xyaxes="1 0 0 0 0.55 0.83" fovy="45"/>
  </worldbody>

  <actuator>
    <position name="joint1_servo" joint="joint1" kp="300" kv="55" ctrlrange="-2.90 2.90"/>
    <position name="joint2_servo" joint="joint2" kp="1000" kv="90" ctrlrange="-1.76 1.76"/>
    <position name="joint3_servo" joint="joint3" kp="1000" kv="90" ctrlrange="-2.90 2.90"/>
    <position name="joint4_servo" joint="joint4" kp="700" kv="70" ctrlrange="-3.07 3.07"/>
    <position name="joint5_servo" joint="joint5" kp="500" kv="55" ctrlrange="-2.90 2.90"/>
    <position name="joint6_servo" joint="joint6" kp="400" kv="45" ctrlrange="-0.02 3.75"/>
    <position name="joint7_servo" joint="joint7" kp="300" kv="40" ctrlrange="-2.90 2.90"/>
    <position name="finger_left_servo" joint="finger_left" kp="12" kv="2" ctrlrange="0 0.035"/>
    <position name="finger_right_servo" joint="finger_right" kp="12" kv="2" ctrlrange="0 0.035"/>
  </actuator>

  <keyframe>
    <key name="home"
         qpos="0 -0.45 0 -1.75 0 1.35 0 0.018 0.018"
         ctrl="0 -0.45 0 -1.75 0 1.35 0 0.018 0.018"/>
  </keyframe>
</mujoco>
