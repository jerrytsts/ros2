<mujoco model="carry_balance_original">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="960" offheight="720"/>
  </visual>

  <default>
    <joint damping="0.25" armature="0.015"/>
    <geom contype="1" conaffinity="1"/>
  </default>

  <asset>
    <material name="metal" rgba="0.72 0.76 0.80 1"/>
    <material name="joint" rgba="0.05 0.06 0.08 1"/>
    <material name="cargo" rgba="0.18 0.65 0.35 1"/>
    <material name="floor" rgba="0.82 0.84 0.88 1"/>
    <material name="accent" rgba="0.94 0.38 0.12 1"/>
  </asset>

  <worldbody>
    <light pos="0.8 -1.2 2.4" dir="-0.3 0.5 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="ground" type="plane" size="2.5 2.5 0.05" material="floor"/>
    <geom name="walkway" type="box" pos="0 0 0.012" size="1.4 0.35 0.012" rgba="0.55 0.62 0.70 1"/>

    <body name="balance_root" pos="0 0 0.88">
      <joint name="root_pitch" type="hinge" axis="0 1 0"
             range="-0.65 0.65" stiffness="14" damping="4"/>
      <joint name="root_yaw" type="hinge" axis="0 0 1"
             range="-0.8 0.8" damping="6"/>

      <geom name="pelvis" type="box" pos="0 0 0.05" size="0.16 0.18 0.09"
            material="joint" mass="7"/>

      <body name="torso" pos="0 0 0.18">
        <joint name="torso_lean" type="hinge" axis="0 1 0"
               range="-0.18 0.18" stiffness="180" damping="12"/>
        <geom name="torso_geom" type="box" pos="0 0 0.24" size="0.15 0.17 0.28"
              material="metal" mass="13"/>
        <geom name="chest" type="box" pos="0.06 0 0.28" size="0.06 0.13 0.12"
              material="accent" mass="1"/>

        <body name="head" pos="0 0 0.57">
          <geom type="sphere" size="0.085" material="joint" mass="2"/>
        </body>

        <body name="cargo_box" pos="0.29 0 0.18">
          <joint name="cargo_jiggle" type="hinge" axis="0 1 0"
                 range="-0.12 0.12" stiffness="500" damping="22"/>
          <geom name="cargo_geom" type="box" size="0.16 0.17 0.13"
                material="cargo" mass="2"/>
          <geom name="cargo_band" type="box" pos="0 0 0" size="0.17 0.05 0.02"
                material="joint" mass="0.15"/>
        </body>

        <body name="left_upper_arm" pos="0 -0.20 0.43">
          <joint name="left_shoulder" type="hinge" axis="0 1 0"
                 range="-1.3 0.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.27" size="0.045"
                material="metal" mass="1.8"/>
          <body name="left_forearm" pos="0 0 -0.27">
            <joint name="left_elbow" type="hinge" axis="0 1 0"
                   range="-1.8 0.1"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.038"
                  material="metal" mass="1.3"/>
          </body>
        </body>

        <body name="right_upper_arm" pos="0 0.20 0.43">
          <joint name="right_shoulder" type="hinge" axis="0 1 0"
                 range="-1.3 0.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.27" size="0.045"
                material="metal" mass="1.8"/>
          <body name="right_forearm" pos="0 0 -0.27">
            <joint name="right_elbow" type="hinge" axis="0 1 0"
                   range="-1.8 0.1"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.038"
                  material="metal" mass="1.3"/>
          </body>
        </body>
      </body>

      <body name="left_leg" pos="0 -0.105 -0.02">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.39" size="0.055"
              material="metal" mass="3.2"/>
        <body name="left_shin" pos="0 0 -0.39">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-1.1 0.2"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.39" size="0.047"
                material="metal" mass="2.3"/>
          <body name="left_foot" pos="0 0 -0.39">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom type="box" pos="0.07 0 -0.035" size="0.15 0.075 0.035"
                  material="joint" mass="1"/>
          </body>
        </body>
      </body>

      <body name="right_leg" pos="0 0.105 -0.02">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.39" size="0.055"
              material="metal" mass="3.2"/>
        <body name="right_shin" pos="0 0 -0.39">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-1.1 0.2"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.39" size="0.047"
                material="metal" mass="2.3"/>
          <body name="right_foot" pos="0 0 -0.39">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom type="box" pos="0.07 0 -0.035" size="0.15 0.075 0.035"
                  material="joint" mass="1"/>
          </body>
        </body>
      </body>
    </body>

    <camera name="front" pos="1.25 -2.25 1.35" xyaxes="1 0 0 0 1 0" fovy="48"/>
    <camera name="side" pos="2.25 -0.05 1.20" xyaxes="0 1 0 -1 0 0" fovy="46"/>
  </worldbody>

  <actuator>
    <motor name="ankle_assist" joint="root_pitch" gear="1" ctrlrange="-180 180"/>
    <motor name="hip_assist" joint="root_pitch" gear="1" ctrlrange="-180 180"/>

    <position name="left_hip_servo" joint="left_hip" kp="90" kv="15" ctrlrange="-0.8 0.8"/>
    <position name="left_knee_servo" joint="left_knee" kp="90" kv="15" ctrlrange="-1.1 0.2"/>
    <position name="left_ankle_servo" joint="left_ankle" kp="70" kv="12" ctrlrange="-0.8 0.8"/>
    <position name="right_hip_servo" joint="right_hip" kp="90" kv="15" ctrlrange="-0.8 0.8"/>
    <position name="right_knee_servo" joint="right_knee" kp="90" kv="15" ctrlrange="-1.1 0.2"/>
    <position name="right_ankle_servo" joint="right_ankle" kp="70" kv="12" ctrlrange="-0.8 0.8"/>

    <position name="left_shoulder_servo" joint="left_shoulder" kp="55" kv="9" ctrlrange="-1.3 0.6"/>
    <position name="left_elbow_servo" joint="left_elbow" kp="45" kv="7" ctrlrange="-1.8 0.1"/>
    <position name="right_shoulder_servo" joint="right_shoulder" kp="55" kv="9" ctrlrange="-1.3 0.6"/>
    <position name="right_elbow_servo" joint="right_elbow" kp="45" kv="7" ctrlrange="-1.8 0.1"/>
  </actuator>
</mujoco>
